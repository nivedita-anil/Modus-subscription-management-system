# --- Database ---
# Local dev works out of the box with SQLite. For Supabase paste the Postgres URI
# (postgresql://... is auto-converted to the async driver).
DATABASE_URL=sqlite+aiosqlite:///./brightloop.db

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Frontend (CORS + reset links) ---
FRONTEND_URL=http://localhost:5173


# --- Email (Resend) - optional until we build email ---
RESEND_API_KEY=
EMAIL_FROM=Brightloop <onboarding@resend.dev>
